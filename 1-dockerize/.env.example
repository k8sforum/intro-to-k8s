RABBITMQ_DEFAULT_USER=user123
RABBITMQ_DEFAULT_PASS=password123
POSTGRES_USER=user123
POSTGRES_PASSWORD=password123
CORE_DB_CONTEXT=Host=postgres;Port=5432;Database=CoreDb;Username=user123;Password=password123
POSTGRES_DB=CoreDb
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5101
RABBIT_MQ_URI=amqp://user123:password123@rabbitmq:5672
MINIO_ROOT_USER=user123
MINIO_ROOT_PASSWORD=password123
MINIO_ENDPOINT=minio:9000
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
ANTHROPIC_MODEL=claude-haiku-4-5
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>
GOOGLE_MAPS_URL=https://maps.googleapis.com
GOOGLE_PLACES_URL=https://places.googleapis.com
VITE_API_BASE_URL=http://localhost:5101
GRAFANA_ADMIN_USER=user123
GRAFANA_ADMIN_PASSWORD=password123
VITE_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
SOLR_URL=http://solr:8983
SOLR_COLLECTION=mytravels-pois
# Set these two once, the same way you set FLAGSMITH_DJANGO_SECRET_KEY below - not seeded.
FLAGSMITH_DJANGO_SECRET_KEY=L9lDCmF07GMcX5dupphe02_eNE4r-GNnpmQX-boa1Y5PWVb4
FLAGSMITH_ADMIN_EMAIL=user123
FLAGSMITH_ADMIN_PASSWORD=password123
# Static, like VITE_API_BASE_URL - the self-hosted Flagsmith REST API the browser calls.
# Without this the Flagsmith JS SDK defaults to the public SaaS edge API, which will
# reject a self-hosted environment key.
VITE_FLAGSMITH_API_URL=http://localhost:8000/api/v1/
# The two below are generated by flagsmith-seed on first `docker compose up`.
# Leave blank - the seed process will fill them in automatically.
FLAGSMITH_SERVER_SIDE_ENVIRONMENT_KEY=
VITE_FLAGSMITH_ENVIRONMENT_ID=
