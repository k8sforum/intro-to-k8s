{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/api/mytravels.api/bin/Debug/net10.0/mytravels.api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/api/mytravels.api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "MESSAGING",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-messaging",
      "program": "${workspaceFolder}/messaging/mytravels.messaging/bin/Debug/net10.0/mytravels.messaging.dll",
      "args": [],
      "cwd": "${workspaceFolder}/messaging/mytravels.messaging",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
