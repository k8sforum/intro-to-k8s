{
  "title": "MyTravels MinIO",
  "uid": "mytravels-minio",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Cluster nodes online / offline",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "minio_cluster_nodes_online_total{job=\"minio\"}",
          "legendFormat": "online"
        },
        {
          "expr": "minio_cluster_nodes_offline_total{job=\"minio\"}",
          "legendFormat": "offline"
        }
      ]
    },
    {
      "id": 2,
      "title": "Usable capacity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "minio_cluster_capacity_usable_total_bytes{job=\"minio\"}",
          "legendFormat": "total"
        },
        {
          "expr": "minio_cluster_capacity_usable_free_bytes{job=\"minio\"}",
          "legendFormat": "free"
        }
      ]
    },
    {
      "id": 3,
      "title": "S3 request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(minio_s3_requests_total{job=\"minio\"}[1m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 4,
      "title": "S3 request errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(minio_s3_requests_errors_total{job=\"minio\"}[1m]))",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": 5,
      "title": "S3 traffic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(minio_s3_traffic_sent_bytes{job=\"minio\"}[1m]))",
          "legendFormat": "sent"
        },
        {
          "expr": "sum(rate(minio_s3_traffic_received_bytes{job=\"minio\"}[1m]))",
          "legendFormat": "received"
        }
      ]
    }
  ]
}
