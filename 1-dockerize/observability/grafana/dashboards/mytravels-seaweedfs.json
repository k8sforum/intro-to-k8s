{
  "title": "MyTravels SeaweedFS",
  "uid": "mytravels-seaweedfs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Node up",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "up{job=\"seaweedfs\"}",
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 2,
      "title": "Volume disk usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "SeaweedFS_volumeServer_resource{job=\"seaweedfs\",type=\"used\"}",
          "legendFormat": "used"
        },
        {
          "expr": "SeaweedFS_volumeServer_resource{job=\"seaweedfs\",type=\"free\"}",
          "legendFormat": "free"
        }
      ]
    },
    {
      "id": 3,
      "title": "S3 request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(SeaweedFS_s3_request_total{job=\"seaweedfs\"}[1m])) by (type)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "S3 request errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(SeaweedFS_s3_request_total{job=\"seaweedfs\",code!~\"2..\"}[1m]))",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": 5,
      "title": "S3 bucket traffic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(SeaweedFS_s3_bucket_traffic_sent_bytes_total{job=\"seaweedfs\"}[1m]))",
          "legendFormat": "sent"
        },
        {
          "expr": "sum(rate(SeaweedFS_s3_bucket_traffic_received_bytes_total{job=\"seaweedfs\"}[1m]))",
          "legendFormat": "received"
        }
      ]
    }
  ]
}
