# Copy to .env and fill in real values. .env is gitignored.
#
# In this lesson .env is not read by docker-compose — it is the input to the
# "create the secrets" step in the runbook, which turns these values into the
# Kubernetes Secrets that the manifests reference by name. The secrets are the one
# part of the stack that deliberately does NOT live in git.

# Argo CD local account (Step 6). The built-in `admin` account cannot be renamed,
# so ARGOCD_USER creates an additional local account with the admin role. Both it
# and `admin` are given ARGOCD_PASSWORD.
ARGOCD_USER=user123
ARGOCD_PASSWORD=password123

# postgres-secret
POSTGRES_USER=user123
POSTGRES_PASSWORD=password123
POSTGRES_DB=CoreDb

# rabbitmq-secret
RABBITMQ_DEFAULT_USER=user123
RABBITMQ_DEFAULT_PASS=password123

# minio-secret
MINIO_ROOT_USER=user123
MINIO_ROOT_PASSWORD=password123

# migrations-secret / api-secret / messaging-secret
CORE_DB_CONTEXT=Host=postgres;Port=5432;Database=CoreDb;Username=user123;Password=password123
RABBIT_MQ_URI=amqp://user123:password123@rabbitmq:5672

# messaging-secret only
CONTENT_SAFETY_ENDPOINT=<YOUR_CONTENT_SAFETY_ENDPOINT>
CONTENT_SAFETY_KEY=<YOUR_CONTENT_SAFETY_KEY>
